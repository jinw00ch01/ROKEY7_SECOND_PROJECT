# Copy this file outside the installed package, fill in real values, then run:
#   export COBOT_VOICE_ENV_PATH=/absolute/path/to/cobot_voice.env

# Required for OpenAI-backed speech/text analysis.
OPENAI_API_KEY=

# Optional Firebase Admin SDK service-account JSON path.
FIREBASE_SERVICE_ACCOUNT=

# Optional ElevenLabs TTS settings.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
COBOT_TTS_ENABLED=1
COBOT_TTS_PROVIDER=auto
