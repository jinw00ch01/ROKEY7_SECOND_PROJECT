<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cobot_voice</name>
  <version>0.0.1</version>
  <description>Voice processing and command parsing for cobot2</description>
  <maintainer email="choijinwoo@todo.todo">choijinwoo</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>cobot_msgs</depend>
  <exec_depend>python3-dotenv</exec_depend>
  <!-- supabase_status_bridge depends on cobot_db (lazy import; node still
       starts and no-ops if cobot_db is missing). -->
  <exec_depend>cobot_db</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
