# =================================================================
# 🐳 ROKEY7_SECOND_PROJECT - Docker Environment SAMPLE
# =================================================================
# 이 파일은 템플릿 샘플입니다. 이 파일을 복사해서 .env 파일을 만드세요.
# 명령어: cp .env.sample .env
# =================================================================

# [1] 실행 프로필 설정 (GPU 사용 여부)
# 🔍 확인: 내 컴퓨터에 NVIDIA GPU가 설치되어 있나요?
# - 있다면: gpu
# - 없다면: cpu
COMPOSE_PROFILES=cpu

# [2] 디스플레이 및 사운드 설정
# 🔍 확인 명령어: echo $DISPLAY
DISPLAY=:0

# 🔍 확인 명령어: echo $XDG_RUNTIME_DIR
XDG_RUNTIME_DIR=/run/user/1000

# [3] 네트워크 및 로봇 연결 설정
# 🔍 확인 명령어: ip addr (또는 ifconfig)
NETWORK_INTERFACE=wlp1s0

# 🔍 확인 명령어: echo $ROS_DOMAIN_ID
ROS_DOMAIN_ID=0

# 🔍 설명: 두산 로봇 컨트롤러의 고정 IP 주소
ROBOT_IP=192.168.1.100

# [4] 하드웨어 장치 설정
# 🔍 확인 명령어: ls /dev/ttyACM* 또는 ls /dev/ttyUSB*
ARDUINO_PORT=/dev/ttyACM0

# [5] DDS(통신) 미들웨어 설정
USE_CYCLONE_DDS=true

# [6] 외부 API 및 보안 설정 (로컬 절대 경로 입력)
FIREBASE_KEY_PATH=/path/to/your/firebase_config.json
OPENAI_ENV_PATH=/path/to/your/.env.openai
