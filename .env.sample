# =================================================================
# 🐳 ROKEY7_SECOND_PROJECT - OD Microservice Environment SAMPLE
# =================================================================

# [1] 디스플레이 설정
# 🔍 확인 명령어: echo $DISPLAY
DISPLAY=:0

# 🔍 확인 명령어: echo $XDG_RUNTIME_DIR
XDG_RUNTIME_DIR=/run/user/1000

# [2] GPU 설정 (NVIDIA GPU 사용자)
# 🔍 설명: NVIDIA Container Toolkit이 설치되어 있어야 GPU 가속이 작동합니다.
# 별도의 변수 수정 없이 도커가 자동으로 GPU를 할당하도록 설정되어 있습니다.

# [2] 네트워크 및 ROS 2 설정
# 🔍 확인 명령어: ip addr (또는 ifconfig)
# 🔍 예: wlp1s0 (Wi-Fi), eth0 (Ethernet)
NETWORK_INTERFACE=wlp1s0

# 🔍 확인 명령어: echo $ROS_DOMAIN_ID
ROS_DOMAIN_ID=0

# [3] DDS(통신) 미들웨어 설정
USE_CYCLONE_DDS=true
