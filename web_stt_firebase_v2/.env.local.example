# Copy to .env.local for local development. NEVER commit real keys.
# These are bundled into the browser build — fine for local/demo use only.
# For production, switch to a serverless proxy that holds the keys server-side.

VITE_OPENAI_API_KEY=
VITE_ELEVENLABS_API_KEY=

# Optional. "freeform" (default) routes through gpt-4o; "menu" matches
# numeric/keyword answers without an LLM call.
VITE_PROMPT_MODE=freeform

# Optional. Set to 0/false to disable ElevenLabs TTS playback.
VITE_TTS_ENABLED=1

# Optional. WebSocket URL of rosbridge_server. When set, a successful
# recommendation triggers /task/start (std_srvs/srv/Trigger) over rosbridge,
# matching the Python voice-alias dispatcher. Leave empty to skip dispatch.
VITE_ROSBRIDGE_URL=ws://localhost:9090
