# Environment variables
.env
secrets_4_firebase_config/

# Python
__pycache__/
*.pyc

# ROS2 build artifacts
build/
install/
log/

# Local editor and debug artifacts
.vscode/
*.log

# Claude Code local settings
.claude/

# OD experiments: exclude images/caches/non-final weights, keep only the
# final operational best.pt per experiment_03.md / experiment_04.md
experiments/cobot_OD_obb_nano/**/*.jpg
experiments/cobot_OD_obb_nano/**/*.png
experiments/cobot_OD_obb_nano/**/*.cache
experiments/cobot_OD_obb_nano/**/*.pt
!experiments/cobot_OD_obb_nano/train_phase2_20260504_173049/weights/best.pt

experiments/cobot_OD_obb_small/**/*.jpg
experiments/cobot_OD_obb_small/**/*.png
experiments/cobot_OD_obb_small/**/*.cache
experiments/cobot_OD_obb_small/**/*.pt
!experiments/cobot_OD_obb_small/train_phase2_20260505_203819/weights/best.pt
cobot_voice/output/

# Python test / lint caches (regenerated by pytest, mypy, ruff)
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Python virtual environments (`env/` matches a directory only; the file
# cobot_voice/cobot_voice/env.py is unaffected)
.venv/
venv/
env/

# Node / frontend artifacts (web_stt_firebase has its own .gitignore;
# these are forward-compatible defaults for any future JS package)
node_modules/

# Local agent / tooling scratch dirs (Codex, Claude harness, etc.)
.agents/
.codex/

# Firebase tooling caches — auto-regenerated by firebase-tools and
# Firebase Data Connect; not part of source. The runtime data dir
# (dataconnect/.dataconnect/pgliteData) lives under this prefix too.
.firebase/
**/dataconnect/.dataconnect/
